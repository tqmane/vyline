# Vyline 環境変数（例）
# コピーして .env として使用。全て任意。

# ── バックエンド ──────────────────────────────
# PORT=3001
# bind アドレス（Docker / 外部公開時は 0.0.0.0）
# VYLINE_HOST=127.0.0.1
# 非loopback bindは既定で起動拒否。認証済みリバースプロキシの後方だけで指定
# VYLINE_TRUSTED_PROXY_AUTH=1
# Docker等でホスト側127.0.0.1へだけポート転送するときのみ指定
# VYLINE_LOOPBACK_PORT_FORWARD=1
# データディレクトリ（トークン / 履歴 / キャッシュ）
# VYLINE_DATA_DIR=backend/data
# スタンプ / sticon キャッシュ
# VYLINE_CDN_CACHE_DIR=backend/data/cdn-cache
# 画像 / 動画メディアキャッシュ
# VYLINE_MEDIA_CACHE_DIR=backend/data/media-cache
# CORS 許可オリジン（dev は Vite 5173）
# VYLINE_CORS_ORIGIN=http://localhost:5173
# デバッグAPI（E2EE状態・メッセージサンプルを含むため本番では有効化しない）
# VYLINE_ENABLE_DEBUG=0
# 公開REST API管理用（32文字以上のランダム値）
# VYLINE_API_ADMIN_SECRET=
# 本番配信するフロントビルドの場所
# VYLINE_STATIC_DIR=Vyline/apps/desktop/dist

# 通知を消費しない受信方式。history（既定）/ sync（全イベント）/ off
# VYLINE_TALK_SYNC_MODE=history
# history モードの履歴確認間隔（最低 2000ms）
# VYLINE_HISTORY_POLL_MS=5000
# ANDROIDSECONDARY で sync を明示した場合、主端末通知を維持する（0 は sync を拒否）
# VYLINE_PRESERVE_PRIMARY_NOTIFICATIONS=1
# sync 互換ヘッダー。実際の状態だけを指定し、回線コードは不明なら設定しない
# VYLINE_SYNC_APP_STATE=B
# VYLINE_SYNC_ACCESS_MODE=w
# VYLINE_SYNC_CARRIER_CODE=

# Android LINE / LEINs バックアップ復元の上限
# VYLINE_ANDROID_DB_MAX_BYTES=536870912
# VYLINE_ANDROID_DB_MAX_CHATS=50000
# VYLINE_ANDROID_DB_MAX_MESSAGES=250000
# VYLINE_ANDROID_ZIP_MAX_MEDIA_BYTES=268435456

# ── デバイス種別 ──────────────────────────────
# VYLINE_DEVICE=ANDROIDSECONDARY
